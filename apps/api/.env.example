# ---- server ----
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ---- security ----
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_0123456789
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_0123456789
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# ---- data ----
DATABASE_URL=file:./data/taskforge.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# ---- client ----
CLIENT_ORIGIN=http://localhost:5173
